@model LoginUserRequest;
@{
    ViewData[Cons.Title] = "Login";
    Layout = "_LayoutAuth";
}



<div class="login-box">
    <div class="card card-outline card-primary">
        <div class="card-header">
            <h1 class="mb-0 text-center"><b>PMS</b></h1>
        </div>
        <div class="card-body login-card-body">
            <p class="login-box-msg">Sign in to start your session</p>
            <form method="post" id="loginForm">
                <div class="input-group mb-3">
                    <div class="form-floating">
                        <input asp-for="UserName" type="text" class="form-control" maxlength="30" placeholder="" />
                        <label>Username</label>
                        <div id="usernameError" class="invalid-feedback"></div>
                    </div>
                    <div class="input-group-text"><span class="bi bi-person-fill"></span></div>
                </div>
                <div class="input-group mb-3">
                    <div class="form-floating">
                        <input asp-for="Password" type="password" class="form-control" maxlength="30" placeholder="" />
                        <label>Password</label>
                        <div id="passwordError" class="invalid-feedback"></div>
                    </div>
                    <div class="input-group-text"><span class="bi bi-lock-fill"></span></div>
                </div>
                <div class="d-grid gap-2 mx-auto">
                    <button id="submitBtn" type="submit" class="btn btn-primary">Sign In</button>
                </div>
            </form>
            <p class="mb-1"><a asp-action="ForgetPassword" asp-controller="Auth">I forgot my password</a></p>
        </div>
    </div>
</div>


    