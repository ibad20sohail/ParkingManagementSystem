@model ResetUserPasswordRequest;
@{
    ViewData[Cons.Title] = "Reset Password";
    Layout = "_LayoutAuth";
}

<div class="login-box">
    <div class="card card-outline card-primary">
        <div class="card-header">
            <h1 class="mb-0 text-center"><b>PMS</b></h1>
        </div>
        <div class="card-body login-card-body">
            <p class="login-box-msg">Reset password</p>
            <form method="post" asp-controller="Auth" asp-action="PostResetPassword" id="resetPasswordForm">
                <div class="input-group mb-3">
                    <div class="form-floating">
                        <input asp-for="Identifier" hidden />
                        <input asp-for="NewPassword" type="password" id="newPassword" class=" form-control" maxlength="30" placeholder="" />
                        <label>New password</label>
                        <div id="newPasswordError" class="invalid-feedback"></div>
                    </div>
                    <div class="input-group-text"><span class="bi bi-lock-fill"></span></div>
                </div>
                <div class="input-group mb-3">
                    <div class="form-floating">
                        <input asp-for="ConfirmPassword" type="password" id="confirmPassword" class="form-control" maxlength="30" placeholder="" />
                        <label>Confirm Password</label>
                        <div id="confirmPasswordError" class="invalid-feedback"></div>
                    </div>
                    <div class="input-group-text"><span class="bi bi-lock-fill"></span></div>
                </div>
                <div class="d-grid gap-2 mx-auto">
                    <button id="submitBtn" type="submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
            <p class="mb-1"><a asp-action="Login" asp-controller="Auth">Go back to login.</a></p>
        </div>
    </div>
</div>