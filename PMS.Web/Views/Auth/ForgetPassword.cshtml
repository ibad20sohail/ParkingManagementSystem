@model GetUserByUsernameRequest;
@{
    ViewData[Cons.Title] = "Forget Password";
    Layout = "_LayoutAuth";
}

<div class="login-box">
    <div class="card card-outline card-primary">
        <div class="card-header">
            <h1 class="mb-0 text-center"><b>PMS</b></h1>
        </div>
        <div class="card-body login-card-body">
            <p class="login-box-msg">Forgot password</p>
            <form method="post" id="forgetPasswordForm">
                <div class="input-group mb-3">
                    <div class="form-floating">
                        <input asp-for="UserName" type="text" id="username" class="form-control" maxlength="30" placeholder="" />
                        <label>Username</label>
                        <div id="usernameError" class="invalid-feedback"></div>
                    </div>
                    <div class="input-group-text"><span class="bi bi-person-fill"></span></div>
                </div>
                <div class="d-grid gap-2 mx-auto">
                    <button id="submitBtn" type="submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
            <p class="mb-1"><a asp-action="Login" asp-controller="Auth">Go back to login.</a></p>
        </div>
    </div>
</div>