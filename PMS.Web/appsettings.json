  },

  "ApplicationParameters": {
    "Domain": "https://localhost:7107",
    "EmailSettings": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "EnableSsl": true,
      "Username": "ibad20sohail@gmail.com", //Replace this with your actual email
      "Password": "", //Replace this with actual app pass
      "FromEmail": "pms.dev@yopmail.com",
      "FromName": "Parking Management System",
      "EnableEmailSend": true
    },
    "CookieSettings": {
      "Name": "PMS - Development",
      "Expiration": 12, //Hours
      "LoginPath": "/Auth/Login",
      "LogoutPath": "/Auth/Logout",
      "AccessDeniedPath": "/Auth/AccessDenied",
      "SlidingExpiration": true
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },

  "AllowedHosts": "*"
}
